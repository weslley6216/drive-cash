POSTGRES_HOST=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Host port published by the db container. Change it when another project on
# the machine already publishes 5432 — a bind conflict leaves the container
# running with no network, and the app then fails to resolve the "db" host.
POSTGRES_PORT=5432

# Transactional email (Resend HTTP API). Only used in production —
# development and test deliver via :test and never call Resend.
RESEND_API_KEY=
MAILER_FROM=no-reply@drivecash.net.br
APP_HOST=drivecash.net.br

# LLM (AI chat). Primary provider + automatic fallback on any Llm::Error.
LLM_PROVIDER=groq
LLM_FALLBACK=gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
